# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
.venv_app/
env/
venv/


# ---------------------------------------------------------------------------
# Secrets & local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Cloud service-account keys (GCP / Vertex AI). These grant API access under
# your billing account — never commit one. Keep the real key outside the repo
# (e.g. ~/.gcp/) and point GOOGLE_APPLICATION_CREDENTIALS at it.
*-service-account*.json
*service_account*.json
*credentials*.json
gcp-*.json
vertex-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# ---------------------------------------------------------------------------
# Data warehouses / databases / runtime logs (regenerated locally)
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.log
qa_history.json

# ---------------------------------------------------------------------------
# Generated artifacts
# ---------------------------------------------------------------------------
output/
output*/
scrape_output/
backend/downloads/
backend/uploads/
backend/knowledge_graphs/
backend/eval/results/

# User-supplied annual-report PDFs stay local; commit only the benchmark labels
# and selection manifest unless the source files are cleared for publication.
TestFile/*.pdf

# Local scratch space for debug dumps / ad-hoc outputs
scratch/
tmp/pdfs/

# Evaluation CSV outputs (keep golden_set.json, drop generated results)
*_evaluation_results.csv
live_ragas_evals.csv

# Local pre-migration snapshots (large binaries, regenerate as needed)
backups/

#Trash
Old_Project_Report/

# Full local evaluation workspaces are retained on disk. Selected, lossless
# evidence archives and readable results are published in published_2026-10-08.
/TestFile/comprehensive_2026-10-04_v1_5/
/TestFile/evaluation-contract-2026-10-05-v2/
/TestFile/evaluation-repair-2026-10-05/
/TestFile/evaluation_A_2026-10-08/
/TestFile/evaluation_B_2026-10-08/
/TestFile/evaluation_completion_2026-10-07/
