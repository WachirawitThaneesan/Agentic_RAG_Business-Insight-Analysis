# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.

# --- Database (PostgreSQL + pgvector) ---
# These POSTGRES_* values are read by docker-compose.yml to provision the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ragdb
# The app itself connects via these URLs — keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5436/ragdb
DATABASE_URL_SYNC=postgresql://postgres:change_me@localhost:5436/ragdb

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama (local embeddings; generation uses Gemini) ---
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text:latest
LLM_PROVIDER=gemini
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-key.json
VERTEX_PROJECT=your-project-id
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0

# --- Optional private offline mode (set these after local model setup) ---
# OFFLINE_MODE=true
# OFFLINE_LLM_MODEL=gemma3:4b
# LOCAL_OCR_PYTHON=C:/path/to/docling-venv/Scripts/python.exe
# LOCAL_OCR_MODELS_DIR=C:/path/to/prefetched/docling-models
# LOCAL_OCR_EASYOCR_CACHE_DIR=C:/path/to/prefetched/easyocr-cache
# PRIVATE_DATA_DIR=C:/Users/you/AppData/Local/financial-rag-private
# With OFFLINE_MODE=true, local OCR/Ollama replace the cloud providers above.
# Public scraping and external search are disabled; the app binds to localhost.

# --- Typhoon OCR / Cloud (used for OCR and as the Ragas judge) ---
TYPHOON_API_KEY=your_key_here
TYPHOON_OCR_ENDPOINT=https://api.opentyphoon.ai/v1/ocr
TYPHOON_OCR_MODEL=typhoon-ocr
# Typhoon reads prose; Gemini extracts tables found on PDF and image pages.
PDF_TABLE_OCR_PROVIDER=gemini
# One higher-resolution retry only for pages with contradictory financial rows.
PDF_QUALITY_REOCR_ENABLED=true
PDF_QUALITY_REOCR_DPI=400
PDF_QUALITY_REOCR_MAX_PAGES=20
TYPHOON_OCR_PAGE_TIMEOUT_SECONDS=240
MAX_UPLOAD_BYTES=250000000

# --- Agentic RAG ---
AGENT_MAX_ITERATIONS=5
AGENT_TEMPERATURE=0.1
AGENT_SELF_CORRECTION=true
AGENT_VERIFY_MAX_RETRIES=1

# --- Knowledge Graph (Hyper-Extract currently uses a separate Ollama client) ---
GRAPH_BUILD_ENABLED=false
HYPEREXTRACT_LLM_MODEL=
HYPEREXTRACT_EMBED_MODEL=nomic-embed-text:latest

# --- External search (optional fallback) ---
TAVILY_API_KEY=

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
